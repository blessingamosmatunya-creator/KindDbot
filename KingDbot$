<xml xmlns="https://developers.google.com/blockly/xml" collection="false">
  <variables>
    <variable id="stake">stake</variable>
    <variable id="prediction">prediction</variable>
    <variable id="stopped">stopped</variable>
  </variables>

  <block type="trade" id="king_trade" x="0" y="0">
    <field name="MARKET_LIST">synthetic_index</field>
    <field name="SUBMARKET_LIST">random_index</field>
    <field name="SYMBOL_LIST">1HZ50V</field>
    <field name="TRADETYPECAT_LIST">digits</field>
    <field name="TRADETYPE_LIST">matchesdiffers</field>
    <field name="TYPE_LIST">DIGITDIFF</field>
    <field name="CANDLEINTERVAL_LIST">60</field>
    <field name="TIME_MACHINE_ENABLED">FALSE</field>
    <field name="RESTARTONERROR">FALSE</field>

    <statement name="INITIALIZATION">
      <block type="variables_set" id="set_stake">
        <field name="VAR" id="stake">stake</field>
        <value name="VALUE">
          <block type="math_number" id="stake_value">
            <field name="NUM">0.10</field>
          </block>
        </value>
        <next>
          <block type="variables_set" id="set_prediction">
            <field name="VAR" id="prediction">prediction</field>
            <value name="VALUE">
              <block type="math_number" id="prediction_value">
                <field name="NUM">5</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="set_stopped">
                <field name="VAR" id="stopped">stopped</field>
                <value name="VALUE">
                  <block type="logic_boolean" id="false_value">
                    <field name="BOOL">FALSE</field>
                  </block>
                </value>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>

    <statement name="SUBMARKET">
      <block type="tradeOptions" id="king_options">
        <field name="DURATIONTYPE_LIST">t</field>
        <field name="CURRENCY_LIST">USD</field>
        <field name="BARRIEROFFSETTYPE_LIST">+</field>
        <field name="SECONDBARRIEROFFSETTYPE_LIST">-</field>
        <value name="DURATION">
          <shadow type="math_number" id="duration">
            <field name="NUM">1</field>
          </shadow>
        </value>
        <value name="AMOUNT">
          <shadow type="math_number" id="amount">
            <field name="NUM">0.10</field>
          </shadow>
          <block type="variables_get" id="get_stake">
            <field name="VAR" id="stake">stake</field>
          </block>
        </value>
        <value name="PREDICTION">
          <shadow type="math_number" id="default_prediction">
            <field name="NUM">5</field>
          </shadow>
          <block type="variables_get" id="get_prediction">
            <field name="VAR" id="prediction">prediction</field>
          </block>
        </value>
      </block>
    </statement>
  </block>

  <block type="before_purchase" id="king_before" x="0" y="500">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="controls_if" id="only_if_not_stopped">
        <value name="IF0">
          <block type="logic_compare" id="stopped_check">
            <field name="OP">EQ</field>
            <value name="A">
              <block type="variables_get" id="get_stopped">
                <field name="VAR" id="stopped">stopped</field>
              </block>
            </value>
            <value name="B">
              <block type="logic_boolean" id="false_check">
                <field name="BOOL">FALSE</field>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="purchase" id="king_purchase">
            <field name="PURCHASE_LIST">DIGITDIFF</field>
          </block>
        </statement>
      </block>
    </statement>
  </block>

  <block type="after_purchase" id="king_after" x="0" y="750">
    <statement name="AFTERPURCHASE_STACK">
      <block type="variables_set" id="stop_after_trade">
        <field name="VAR" id="stopped">stopped</field>
        <value name="VALUE">
          <block type="logic_boolean" id="true_value">
            <field name="BOOL">TRUE</field>
          </block>
        </value>
        <next>
          <block type="notify" id="stop_notice">
            <field name="NOTIFICATION_TYPE">info</field>
            <field name="NOTIFICATION_SOUND">silent</field>
            <value name="MESSAGE">
              <shadow type="text" id="notice_text">
                <field name="TEXT">KING Differ BOT stopped after one contract. Check your balance before restarting.</field>
              </shadow>
            </value>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>
